# Models
NLP_MODEL=
# Embeddings (using Transformers.js locally)
EMBEDDING_MODEL='Xenova/all-MiniLM-L6-v2'
# Neo4j
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
NEO4J_URI=bolt://localhost:7687
NEO4J_DATABASE=neo4j
# Vector search threshold
NEO4J_VECTOR_THRESHOLD=0.9
# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_SITE_NAME=module-10-rag-embeddings-semantic-search

# PDF to ingest (relative to the module root)
PDF_PATH=src/assets/pdfs/sample.pdf
